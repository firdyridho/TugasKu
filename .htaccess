RewriteEngine On

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# 1. Physical files and directories - serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Well-known clean routes (works on all hostings & subdirectories)
RewriteRule ^status/?$ status.php [L,QSA]
RewriteRule ^changelog/?$ changelog.php [L,QSA]
RewriteRule ^privacy/?$ privacy.php [L,QSA]
RewriteRule ^ekspor/?$ ekspor.php [L,QSA]
RewriteRule ^proses/?$ proses.php [L,QSA]
RewriteRule ^widget/?$ widget/index.php [L,QSA]
RewriteRule ^api/widget/?$ api/widget.php [L,QSA]

# Auth routes
RewriteRule ^auth/login/?$ auth/login.php [L,QSA]
RewriteRule ^auth/logout/?$ auth/logout.php [L,QSA]
RewriteRule ^auth/register/?$ auth/register.php [L,QSA]

# Submodule detail routes
RewriteRule ^kuliah/detail/?$ kuliah/detail.php [L,QSA]
RewriteRule ^organisasi/detail/?$ organisasi/detail.php [L,QSA]

# 3. Generic clean URL: rewrite extensionless request to .php if it exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
